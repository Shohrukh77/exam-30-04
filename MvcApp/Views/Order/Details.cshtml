@model Domain.Entities.Order

<h2>Детали заказа</h2>

<p><strong>Клиент:</strong> @Model.Customer.FullName</p>
<p><strong>Дата заказа:</strong> @Model.OrderDate.ToShortDateString()</p>

<table class="table">
    <thead>
    <tr>
        <th>Товар</th>
        <th>Кол-во</th>
        <th>Цена</th>
    </tr>
    </thead>
    <tbody>
    @{
        decimal total = 0;
    }
    @foreach (var item in Model.Items)
    {
        var sum = item.Quantity * item.Product.Price;
        total += sum;
        <tr>
            <td>@item.Product.Name</td>
            <td>@item.Quantity</td>
            <td>@sum</td>
        </tr>
    }
    </tbody>
</table>

<p><strong>Итоговая сумма:</strong> @total сомони</p>