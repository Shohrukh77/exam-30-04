@model List<Domain.Entities.Order>

<h2>Список заказов</h2>

<table class="table">
    <thead>
    <tr>
        <th>Клиент</th>
        <th>Дата</th>
        <th>Действия</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var order in Model)
    {
        <tr>
            <td>@order.Customer.FullName</td>
            <td>@order.OrderDate.ToShortDateString()</td>
            <td><a href="@Url.Action("Details", "Order", new { id = order.Id })">Подробнее</a></td>
        </tr>
    }
    </tbody>
</table>