@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Domain.Entities.Order

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Create Order</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</head>
<body>
<div class="container mt-5">
    <h2>Create Order</h2>

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label for="CustomerId" class="form-label">Customer:</label>
            <select id="CustomerId" name="CustomerId" class="form-select">
                <option value="1">Абдуллоев Саид</option>
                <option value="2">Муратова Дилрабо</option>
                <option value="3">Насруллоев Зариф</option>
            </select>
        </div>

        <div class="mb-3">
            <label for="OrderDate" class="form-label">Order Date:</label>
            <input type="date" id="OrderDate" name="OrderDate" class="form-control" />
        </div>

        <h5>Product 1</h5>
        <div class="mb-3">
            <select name="Items[0].ProductId" class="form-select">
                <option value="1">Ноутбук Lenovo</option>
                <option value="2">Мышка Logitech</option>
                <option value="3">Клавиатура A4Tech</option>
            </select>
            <input type="number" name="Items[0].Quantity" class="form-control mt-2" placeholder="Quantity" min="1" value="1" />
        </div>

        <h5>Product 2</h5>
        <div class="mb-3">
            <select name="Items[1].ProductId" class="form-select">
                <option value="1">Ноутбук Lenovo</option>
                <option value="2">Мышка Logitech</option>
                <option value="3">Клавиатура A4Tech</option>
            </select>
            <input type="number" name="Items[1].Quantity" class="form-control mt-2" placeholder="Quantity" min="1" value="1" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>

        <a href="/Order/Index" class="btn btn-secondary mt-3">К списку заказов</a>
    </form>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>